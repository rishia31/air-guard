# Copy to .env and fill in what you have. Everything is optional: with nothing set, Airmate runs
# offline on SQLite with template replies instead of Grok.

# --- Grok (xAI) -----------------------------------------------------------------------------------
XAI_API_KEY=
# Model ids are placeholders until A1 confirms them against https://docs.x.ai
# GROK_CHAT_MODEL=grok-4.3
# GROK_REPORT_MODEL=grok-4.7
# GROK_VOICE_MODEL=grok-voice-latest
# GROK_VOICE=eve

# --- Storage --------------------------------------------------------------------------------------
# Default: SQLite at backend/data/airmate.db. For Supabase, paste the Postgres connection string and
# install the extra: uv sync --extra postgres
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# --- Outside data ---------------------------------------------------------------------------------
# Open-Meteo is used when these are empty (no key needed).
AIRNOW_API_KEY=
GOOGLE_POLLEN_API_KEY=

# --- Buddy / caregiver push notifications via ntfy --------------------------------------------------
# Buddies subscribe to "<prefix>-<user id>" in the ntfy app. Pick something unguessable.
NTFY_TOPIC_PREFIX=
# NTFY_SERVER=https://ntfy.sh

# --- Devices --------------------------------------------------------------------------------------
# If set, the ESP32 and the simulator must send it as the X-Device-Key header.
DEVICE_KEY=
# DEFAULT_USER_ID=maya

# --- Server ---------------------------------------------------------------------------------------
# PUBLIC_WEB_URL=http://localhost:8000
# CORS_ORIGINS=*
# AIRMATE_OFFLINE=false
# AIRMATE_SEED=true
# HIGH_RISK_SCORE=45
# CHECKIN_JUMP_POINTS=12

# --- Web app (web/.env.local) ---------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
